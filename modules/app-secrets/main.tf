# Application secrets in AWS Secrets Manager. Kubernetes gets them through the External
# Secrets Operator (platform stack), so no secret value is ever written into a Kubernetes
# manifest, a .tfvars file, or Git.
#
#   <prefix>/shared           JWT_SECRET, INTERNAL_API_KEY  generated here, used by both services
#   <prefix>/core-service     MONGO_URI                     written by the database stack (or by you)
#   <prefix>/order-service    MONGO_URI                     written by the database stack (or by you)
#   <prefix>/payment-gateway  PaymentGateway_*              set by you; Terraform never sees it
#
# The JSON keys are exactly the environment variable names the services read.

locals {
  secrets = {
    "shared"          = "JWT_SECRET and INTERNAL_API_KEY shared by core-service and order-service. Generated by Terraform."
    "core-service"    = "MONGO_URI for core-service. Written by the database stack, or set by hand when MongoDB is managed elsewhere."
    "order-service"   = "MONGO_URI for order-service. Written by the database stack, or set by hand when MongoDB is managed elsewhere."
    "payment-gateway" = "UPI payment provider credentials for order-service. Set by hand; never stored in Terraform."
  }
}

resource "aws_secretsmanager_secret" "this" {
  for_each = local.secrets

  name                    = "${var.prefix}/${each.key}"
  description             = each.value
  recovery_window_in_days = var.recovery_window_in_days
}

# Ephemeral values exist only while Terraform runs: they are never written to the state file
# or the plan. They are passed to the write-only argument below, which AWS stores and
# Terraform forgets.
ephemeral "random_password" "jwt_secret" {
  length  = 64
  special = false
}

ephemeral "random_password" "internal_api_key" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret_version" "shared" {
  secret_id = aws_secretsmanager_secret.this["shared"].id

  secret_string_wo = jsonencode({
    JWT_SECRET       = ephemeral.random_password.jwt_secret.result
    INTERNAL_API_KEY = ephemeral.random_password.internal_api_key.result
  })

  # The value is only sent when this number changes, so new random values generated on
  # later runs are ignored. Bump it to rotate.
  secret_string_wo_version = var.shared_secrets_version
}
